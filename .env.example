# URL pública de la API, incluyendo /api. En desarrollo puede omitirse.
VITE_API_URL=https://tu-backend.example.com/api

# URL pública del servidor que almacena las imágenes. Si se omite, se deriva de VITE_API_URL.
VITE_MEDIA_URL=https://tu-backend.example.com

# Client ID público de Google OAuth.
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
